# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/csir_serc_portal?schema=public"
PRISMA_QUERY_ENGINE_BINARY="C:\\Users\\Administrator\\.prisma\\query-engine-windows.exe"
PRISMA_QUERY_ENGINE_LIBRARY="C:\\Users\\Administrator\\.prisma\\query_engine-windows.dll.node"

# JWT Secrets
JWT_ACCESS_SECRET="your-jwt-access-secret-key"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# SMTP Configuration (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="ictserc@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="CSIR-SERC Portal <noreply@serc.res.in>"

# Currency API (FreeCurrencyAPI)
CURRENCY_API_KEY="fca_live_YOUR_API_KEY_HERE"
CURRENCY_API_URL="https://api.freecurrencyapi.com/v1/latest"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=52428800

# 2FA
TWO_FA_ISSUER="CSIR-SERC Portal"
